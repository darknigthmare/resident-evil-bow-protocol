    {
      "source_id": "SRC_RE3R_PLAZA_NATIVE",
      "name": "Shopping Plaza, façade Moon’s Donuts",
      "local_reference_file": "/workspace/scratch/37b119cd013c/v24-stage-references/re3-plaza.jpg",
      "page_url": "https://www.gamesradar.com/resident-evil-3-remake-review/",
