    {
      "source_id": "SRC_TYRANT_HD_NATIVE",
      "name": "Tyrant Room, capture HD Remaster",
      "local_reference_file": "/workspace/scratch/37b119cd013c/v24-stage-references/tyrant-native.jpg",
      "page_url": "https://adventuregamers.com/walkthroughs/resident-evil-hd-remaster",
      "image_url": "https://adventuregamers.com/wp-content/uploads/2026/02/Resident-Evil-HD-Remaster-Tyrant.jpg",
      "edition": "Resident Evil HD Remaster (2015 ; remaster du remake 2002), plateforme de capture non précisée",
      "source_kind": "native_game_screenshot_hosted_by_third_party",
      "downloaded_and_visually_inspected": true,
      "used_for_generation": true,
      "observations": [
        "Caméra basse oblique, mur technique gauche, consoles arrière, rangée de cuves cyan à droite et sol réfléchissant.",
        "Tyrant debout au centre et personnage humain en arrière-plan masquent une partie du sol et des consoles."
      ],
      "limitations": [
        "Ce n’est pas une capture RE1996 ni une salle NEST.",
        "La capture qualifie cette caméra, pas tout le laboratoire ou sa topologie complète."
      ],
